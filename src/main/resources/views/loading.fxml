<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.kossurvival.controller.LoadingController"
           prefWidth="960.0" prefHeight="540.0"
           style="-fx-background-color: #3b8fd9;">

    <!-- LAYER 1: ILUSTRASI KOTA PERKAMPUNGAN INDONESIA (RETRO PIXEL ART) -->
    <ImageView fx:id="cityBgView" fitWidth="960.0" fitHeight="540.0" mouseTransparent="true" />

    <!-- LAYER 2: OVERLAY ATMOSFERIK SOFT DIM -->
    <StackPane mouseTransparent="true"
               style="-fx-background-color: linear-gradient(to bottom, rgba(10, 20, 35, 0.45) 0%, rgba(10, 20, 35, 0.75) 100%);" />

    <!-- LAYER 3: ELEMEN LOADING RETRO ARCADE -->
    <AnchorPane prefWidth="960.0" prefHeight="540.0">

        <!-- LOGO JUDUL RETRO PIXEL ART (ALL YELLOW & SUPER BIG) -->
        <VBox alignment="CENTER" spacing="6.0" AnchorPane.topAnchor="40.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <Text fx:id="titleKos" text="KOS" styleClass="pixel-title-main" />
            <Text fx:id="titleSurvival" text="SURVIVAL" styleClass="pixel-title-main-sub" />
        </VBox>

        <!-- KONTEN PROGRESS BAR & TIPS DI BAWAH -->
        <VBox alignment="CENTER" spacing="12.0" AnchorPane.bottomAnchor="36.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <!-- Progress Bar Retro Arcade -->
            <ProgressBar fx:id="progressBar" prefWidth="580.0" prefHeight="24.0" progress="0.0"
                         styleClass="citampi-progress-bar" />

            <!-- Teks Status Loading Persen -->
            <Label fx:id="statusLabel" text="MEMUAT KEHIDUPAN KOS... 0%"
                   style="-fx-font-family: 'Press Start 2P', monospace; -fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #ffd32a; -fx-effect: dropshadow(one-pass-box, #000, 0, 0, 2, 2);" />

            <!-- Kutipan Tips Anak Kos Retro -->
            <Label fx:id="tipLabel" text="Tips: Sedia tolak angin &amp; obat maag sebelum terserang tipes!"
                   style="-fx-font-family: 'Press Start 2P', monospace; -fx-font-size: 10px; -fx-text-fill: #ffeaa7; -fx-effect: dropshadow(one-pass-box, #000, 0, 0, 2, 2);"
                   wrapText="true" textAlignment="CENTER" maxWidth="720.0" />
        </VBox>

    </AnchorPane>

</StackPane>
