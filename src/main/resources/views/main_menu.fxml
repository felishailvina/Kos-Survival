<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.kossurvival.controller.MainMenuController"
           prefWidth="960.0" prefHeight="540.0"
           style="-fx-background-color: #3b8fd9;">

    <!-- LAYER 1: ILUSTRASI KOTA PERKAMPUNGAN INDONESIA (RETRO PIXEL ART) -->
    <ImageView fx:id="cityBgView" fitWidth="960.0" fitHeight="540.0" mouseTransparent="true" />

    <!-- LAYER 2: INTERFACE & ELEMEN UI RETRO ARCADE -->
    <AnchorPane prefWidth="960.0" prefHeight="540.0">

        <!-- TENGAH ATAS: LOGO JUDUL RETRO PIXEL ART (ALL YELLOW, SUPER BIG & EYECATCHING) -->
        <VBox alignment="CENTER" spacing="4.0" AnchorPane.topAnchor="16.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

            <!-- Main Title Word 1: KOS (82px All-Yellow 3D Pixel) -->
            <Text fx:id="titleKos" text="KOS" styleClass="pixel-title-main" />

            <!-- Main Title Word 2: SURVIVAL (56px All-Yellow 3D Pixel) -->
            <Text fx:id="titleSurvival" text="SURVIVAL" styleClass="pixel-title-main-sub" />
        </VBox>

        <!-- TENGAH: TOMBOL UTAMA RETRO ARCADE (MATCHING [ START ] BUTTON) -->
        <VBox alignment="CENTER" spacing="14.0" AnchorPane.topAnchor="270.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <Button fx:id="btnStart" text="START GAME"
                    styleClass="pixel-btn-start" prefWidth="350.0" prefHeight="52.0"
                    onAction="#handleStartGame" />

            <Button fx:id="btnLoad" text="BACA PANDUAN"
                    styleClass="pixel-btn-secondary" prefWidth="350.0" prefHeight="48.0"
                    onAction="#handleShowInstructions" />
        </VBox>

    </AnchorPane>

</StackPane>
